{;; JVM classpath — the compatible superset of bb.edn (bb is the primary
 ;; runtime; keep both in sync). nrepl/nrepl is JVM-only: babashka ships its
 ;; own nREPL server (babashka.nrepl.server).
 :paths ["src/main" "resources"]
 :deps  {org.clojure/clojure        {:mvn/version "1.12.0"}
         com.fulcrologic/escapement {:mvn/version "1.0.1"}
         nrepl/nrepl                {:mvn/version "1.3.1"}
         ;; bencode.core — net.clj's codec. Bundled in babashka; NOT a
         ;; transitive dep of nrepl/nrepl on the JVM (nrepl has its own
         ;; internal nrepl.bencode) — the twin suite caught the gap the day
         ;; client-test first loaded net.clj under the JVM.
         nrepl/bencode              {:mvn/version "1.2.0"}}
 :aliases
 {;; JVM twin of `bb llm-repl` — args pass through the same way:
  ;;   clojure -M:llm-repl [--plain | --headless]
  :llm-repl {:main-opts ["-m" "us.whitford.llm-repl.main"]}
  ;; D6 twin: `bb test` ≡ `clojure -M:run-tests` — same suite, both runtimes
  ;; run THIS ns's -main (src/test/us/whitford/llm_repl/test_runner.clj).
  :run-tests {:extra-paths ["src/test"]
              :main-opts   ["-m" "us.whitford.llm-repl.test-runner"]}}}
